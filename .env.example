NODE_ENV=development
# Escuta em todas as interfaces para permitir testes por outros dispositivos da rede local.
HOST=0.0.0.0
PORT=3000

# Preencha com os dados do PostgreSQL existente.
PGHOST=localhost
PGPORT=5432
PGDATABASE=bolivas_eletroinfo
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# Segredo obrigatório usado somente para gerar hashes HMAC das credenciais.
API_TOKEN_PEPPER=
